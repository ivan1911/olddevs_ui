{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  // Истории и .storybook в пакет не уезжают: они не часть публичного API, а их
  // импорты (@storybook/*) утащили бы devDependencies в рантайм потребителя.
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/**/*.stories.tsx", "tests", "tests-visual"]
}
